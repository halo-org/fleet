package fleet:host@0.0.0;

/// Workspace access scoped to an acting agent.
interface workspace {
    use fleet:common/types@0.0.0.{
        workspace-context, workspace-write, workspace-command, workspace-output, workspaces-error,
    };

    /// An opened environment and its relative directory view.
    record workspace-binding {
        context: workspace-context,
        directory: option<string>,
    }

    /// Loads the agent's current role and workspace, resolves references and opens the environment.
    /// Retain this binding throughout an operation, including read-modify-write.
    open: async func() -> result<workspace-binding, workspaces-error>;

    /// Reads through the view. Absolute paths remain environment-absolute.
    read: async func(binding: workspace-binding, path: string, limit: u64)
        -> result<list<u8>, workspaces-error>;

    /// Writes through the view. Expected contents follow the workspaces contract.
    write: async func(binding: workspace-binding, file: workspace-write)
        -> result<_, workspaces-error>;

    /// Executes through the view. The view supplies the default or relative working directory.
    /// Cancellation and retry follow the workspaces contract.
    exec: async func(binding: workspace-binding, is-retry: bool, command: workspace-command)
        -> result<workspace-output, workspaces-error>;
}

world workspace-host {
    import workspace;
}
