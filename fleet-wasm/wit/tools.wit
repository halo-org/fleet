/// Provides access to tools.
interface tools {
    use types.{json-object, tool, tool-name, tool-context, tool-output};

    /// The kind of error returned by a tools provider.
    enum tools-error-kind {
        /// Retrying the tool call risks repeating effects of an earlier attempt.
        unsafe-to-retry,
        /// An error not covered by any other kind.
        other,
    }

    /// An error returned by a tools provider.
    record tools-error {
        /// The kind of error.
        kind: tools-error-kind,
        /// A description of the error.
        message: string,
    }

    /// Returns the tool with the given name.
    get: async func(name: tool-name) -> result<option<tool>, tools-error>;

    /// Executes a tool.
    ///
    /// is-retry indicates whether this call may have been attempted before.
    /// An earlier attempt may still be running or may already have completed.
    /// Tool outputs with is-error set are successful results and should not be retried.
    execute: async func(
        context: tool-context,
        is-retry: bool,
        input: json-object,
    ) -> result<tool-output, tools-error>;

    /// Returns the output for an interrupted tool call.
    ///
    /// This does not interrupt ongoing calls. It only builds their interrupted output.
    interrupted-output: async func(
        context: tool-context,
        input: json-object,
    ) -> result<tool-output, tools-error>;
}

/// A component that provides tools.
world tool-provider {
    import configuration;
    export tools;
}
