/// Provides workspace environments.
///
/// Environment identity survives provider restarts. Contexts with the same workspace and ID share
/// the environment.
/// Different IDs do not guarantee isolation, for example when they name the same local directory.
/// Paths use / separators. Relative paths start in the workspace directory.
/// Absolute paths refer to the workspace environment. Access is controlled by the provider.
interface workspaces {
    use types.{
        workspace, workspace-context, workspace-write, workspace-command, workspace-output,
        workspaces-error,
    };

    /// Returns the workspace with the given name.
    get: async func(name: string) -> result<option<workspace>, workspaces-error>;

    /// Creates or reopens a workspace environment.
    ///
    /// Concurrent and repeated calls with the same context open the same environment.
    /// Cancelling a call may leave provisioning in progress. Retrying must resume it.
    /// Dropping the provider does not remove environments.
    /// An existing ID with incompatible configuration returns invalid-configuration.
    open: async func(context: workspace-context) -> result<_, workspaces-error>;

    /// Discards the resources held for a workspace environment.
    ///
    /// A later open provisions the environment again. Releasing an environment that was never
    /// opened or was already released succeeds without provisioning anything.
    /// Release only when nothing else uses the environment. Programs left running by earlier
    /// calls may fail. Retrying a failed release must resume it.
    release: async func(context: workspace-context) -> result<_, workspaces-error>;

    /// Reads a file from an open workspace.
    ///
    /// Files exceeding the limit return file-too-large.
    read: async func(context: workspace-context, path: string, limit: u64)
        -> result<list<u8>, workspaces-error>;

    /// Creates or replaces a file in an open workspace.
    ///
    /// Readers see either the old or new contents. Expected contents are checked before replacement.
    /// A mismatch or missing file returns file-changed. This is not an atomic comparison against
    /// programs outside the provider.
    write: async func(context: workspace-context, file: workspace-write)
        -> result<_, workspaces-error>;

    /// Runs a command to completion in an open workspace.
    ///
    /// is-retry indicates that this execution may have been attempted before. An earlier attempt
    /// may still be running or may have completed. Reuse the command ID when retrying.
    /// Cancelling the call does not guarantee that the program stops.
    /// Timeouts and nonzero exit codes are returned as command outcomes.
    /// A retry that could repeat effects returns unsafe-to-retry.
    exec: async func(context: workspace-context, is-retry: bool, command: workspace-command)
        -> result<workspace-output, workspaces-error>;
}

/// A component that provides workspaces.
world workspace-provider {
    import configuration;
    export workspaces;
}
