{
  "listen": "127.0.0.1:1337",
  "plugins": {
    "agents": {
      "path": "../../target/wasm32-unknown-unknown/release/fleet_plugin_agents.wasm"
    },
    "roles": {
      "path": "../../target/wasm32-unknown-unknown/release/fleet_plugin_roles.wasm"
    },
    "sandbox": {
      "path": "../../target/wasm32-unknown-unknown/release/fleet_plugin_sandbox.wasm"
    },
    "tasks": {
      "path": "../../target/wasm32-unknown-unknown/release/fleet_plugin_tasks.wasm"
    },
    "tools": {
      "path": "../../target/wasm32-unknown-unknown/release/fleet_plugin_tools.wasm"
    }
  },
  "providers": {
    "agents": {
      "plugin": "agents",
      "capabilities": {
        "agents": true,
        "blobs": true,
        "roles": "read",
        "tool_calls": true
      }
    },
    "roles": {
      "plugin": "roles",
      "capabilities": {
        "roles": true
      }
    },
    "sandbox": {
      "plugin": "sandbox",
      "config": {
        "oauth": "http://127.0.0.1:1337/sandbox/oauth"
      },
      "capabilities": {
        "credentials": true,
        "workers": true
      }
    },
    "tasks": {
      "plugin": "tasks",
      "capabilities": {
        "tool_calls": true
      }
    },
    "tools": {
      "plugin": "tools",
      "capabilities": {
        "blobs": true,
        "workspaces": ["sandbox", "agents"]
      }
    }
  }
}
